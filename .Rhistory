noms <- read.csv("external data/GeoPolHist_entities.csv", stringsAsFactors = FALSE) %>%
transmute(gph = as.character(GPH_code), nom = GPH_name)
a_coder <- master %>%
filter(as.integer(source) > 999 | as.integer(target) > 999) %>%
anti_join(manuel, by = "key") %>%
