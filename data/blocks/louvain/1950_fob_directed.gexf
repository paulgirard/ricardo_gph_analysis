      <attribute id="valueToSplit" title="valueToSplit" type="string"/>
      <attribute id="newReporters" title="newReporters" type="string"/>
      <attribute id="newPartners" title="newPartners" type="string"/>
      <attribute id="originalReportedTradeFlowIds" title="originalReportedTradeFlowIds" type="string"/>
      <attribute id="status" title="status" type="string"/>
      <attribute id="notes" title="notes" type="string"/>
      <attribute id="proximity" title="proximity" type="double"/>
      <attribute id="TIBI" title="TIBI" type="double"/>
    </attributes>
